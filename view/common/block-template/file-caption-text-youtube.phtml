                            <button class="button-small pure-button button-seccondary pure-button-active"><a href="#" onclick="OneTrust.ToggleInfoDisplay(); return false;">Visit the Privacy preference centre</a></button>
                    </div>

                    <!-- Hide warning once C0004 is enabled -->
                    <script type="text/plain" class="optanon-category-C0004">
                        document.querySelector('#placeholder-<?php echo $media->id(); ?> .ot-warning')
